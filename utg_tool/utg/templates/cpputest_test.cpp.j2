{#- CppUTest test-file template (Module 10). Keep logic out of here: everything is pre-computed. -#}
/**
 * \file  test_{{ function }}.cpp
 * \brief Unit tests for {{ function }}().
 * \author Subhasish Singha <subhasish.singha1@kiongroup.com>
 *
 * Strategies : {{ strategies }}
 * Scenarios  : {{ scenarios | length }}
 */
{% for line in includes %}
{{ line }}
{% endfor %}

{% if emit_group %}
TEST_GROUP({{ group }})
{
    void setup()
    {
        mock().clear();
    }

    void teardown()
    {
        mock().clear();
    }
};

{% endif %}
{% for sc in scenarios %}
/**
 * \brief {{ sc.brief }}
 *
 * \test
{% for line in sc.pre %}
 * \pre {{ line }}
{% endfor %}
{% for line in sc.post %}
 * \post {{ line }}
{% endfor %}
 */
TEST({{ group }}, {{ sc.name }})
{
    /* Initialize input variables */
{% for line in sc.init_lines %}
    {{ line }}
{% endfor %}

    /* Configure mock expectations */
{% for line in sc.mock_lines %}
    {{ line }}
{% endfor %}

    /* Execute the function */
    {{ sc.call_line }}

    /* Check return value */
{% for line in sc.ret_checks %}
    {{ line }}
{% endfor %}

    /* Check modified variables */
{% for line in sc.var_checks %}
    {{ line }}
{% endfor %}

    /* Check mock expectations */
    mock().checkExpectations();
}

{% endfor %}
